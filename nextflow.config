/*
========================================================================================
    Base Nextflow configuration
========================================================================================
    Minimal config for the hackathon scaffold. Add process-level resources,
    container definitions, and extra config files under conf/ as needed.
========================================================================================
*/

manifest {
    name            = 'SVantigen'
    author          = 'Group 8'
    description     = 'Identifying candidate neoantigens and druggable mutations in SV space'
    mainScript      = 'main.nf'
    nextflowVersion = '>=26.04.6'
    version         = '0.1.0'
}

params {
    input            = null
    fasta            = null
    reads            = null
    reference        = null
    reference_index  = null
    variants         = null
    outdir           = './results'
    enable_gpu       = false
}

profiles {
    standard {
        docker.enabled = false
    }
    docker {
        docker.enabled = true
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    test {
        includeConfig 'conf/test.config'
    }
}

timeline {
    enabled   = false
    overwrite = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
}
report {
    enabled   = false
    overwrite = true
    file      = "${params.outdir}/pipeline_info/report.html"
}
trace {
    enabled   = false
    overwrite = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
}
