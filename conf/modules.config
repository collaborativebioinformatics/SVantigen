/*
========================================================================================
    Config file for defining DSL2 process options and publishing paths
========================================================================================
    Defines process-specific publishDir settings following nf-core standards.
========================================================================================
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'VALIDATE_NORMALIZE_VARIANTS' {
        publishDir = [
            path: { "${params.outdir}/pangenome/normalized_vcf" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SVAHA3_BUILD_GRAPH' {
        publishDir = [
            path: { "${params.outdir}/pangenome/graph" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'VG_AUTOINDEX' {
        publishDir = [
            path: { "${params.outdir}/pangenome/index" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'VG_CALL' {
        publishDir = [
            path: { "${params.outdir}/recurrent_variants/vg_call" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FILTER_SOMATIC_VARIANTS' {
        publishDir = [
            path: { "${params.outdir}/recurrent_variants/filtered" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'COLLECT_QC_REPORT' {
        publishDir = [
            path: { "${params.outdir}/reports/qc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MINIMAP2_ALIGN' {
        publishDir = [
            path: { "${params.outdir}/personal_variants/alignments" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'DEEPSOMATIC_CALL' {
        publishDir = [
            path: { "${params.outdir}/personal_variants/deepsomatic" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SNIFFLES2_CALL' {
        publishDir = [
            path: { "${params.outdir}/personal_variants/sniffles2" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}
