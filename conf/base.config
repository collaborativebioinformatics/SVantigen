/*
========================================================================================
    Base Nextflow Configuration
========================================================================================
    Defines default process settings, resource allocations, and execution monitoring.
========================================================================================
*/

process {
    shell        = ['/usr/bin/env', 'bash', '-euo', 'pipefail']
    stageInMode  = 'symlink'
    stageOutMode = 'copy'
    errorStrategy = 'terminate'
    maxRetries   = 0

    withLabel: 'process_single' {
        cpus   = { 1 * task.attempt }
        memory = { 2.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
    withLabel: 'process_low' {
        cpus   = { 2 * task.attempt }
        memory = { 4.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withLabel: 'process_medium' {
        cpus   = { 4 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }
    withLabel: 'process_high' {
        cpus   = { 4 * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
}

// ----------------------------------------------------------------------------------------
// Pipeline Monitoring & Reports
// ----------------------------------------------------------------------------------------
timeline {
    enabled   = true
    file      = "${params.outdir ?: 'results'}/pipeline_info/execution_timeline.html"
    overwrite = true
}

report {
    enabled   = true
    file      = "${params.outdir ?: 'results'}/pipeline_info/execution_report.html"
    overwrite = true
}

trace {
    enabled   = true
    file      = "${params.outdir ?: 'results'}/pipeline_info/execution_trace.tsv"
    overwrite = true
    fields    = 'task_id,process,tag,status,exit,submit,start,complete,duration,realtime,%cpu,rss,peak_rss,cpus,memory,disk,attempt,hash,workdir'
}

dag {
    enabled   = true
    file      = "${params.outdir ?: 'results'}/pipeline_info/pipeline_dag.html"
    overwrite = true
}
