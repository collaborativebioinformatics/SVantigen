/*
========================================================================================
    HPC Execution Profile Config
========================================================================================
    Process resources for HPC scheduler environments (SLURM / LSF).
========================================================================================
*/

process {
    executor = 'slurm'
    queue    = params.slurm_queue ?: 'normal'

    withLabel: 'process_single' {
        cpus   = 1
        memory = 4.GB
        time   = 2.h
    }
    withLabel: 'process_low' {
        cpus   = 4
        memory = 16.GB
        time   = 6.h
    }
    withLabel: 'process_medium' {
        cpus   = 8
        memory = 32.GB
        time   = 12.h
    }
    withLabel: 'process_high' {
        cpus   = 16
        memory = 64.GB
        time   = 24.h
    }
}
